{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    // @repo/ui ships source-only, so this exploration's tsc compiles its
    // .tsx too — and TS won't extension-probe the wildcard targets in the ui
    // package.json `imports` the way Vite/Node do. Mirror the `#` aliases
    // here so the library source typechecks from this side.
    "paths": {
      "#lib/*": ["../../packages/ui/src/lib/*"],
      "#components/*": ["../../packages/ui/src/components/*"],
      "#hooks/*": ["../../packages/ui/src/hooks/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

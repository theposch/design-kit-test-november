        "$type": "fontWeight",
        "$value": 600,
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Phone",
            "modes": { "Tablet and desktop": 600 }
          }
        }
      }
    }
  },
  "Motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": { "value": 150, "unit": "ms" },
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Default",
            "modes": { "Reduced motion": { "value": 0, "unit": "ms" } }
          }
        }
      },
      "normal": {
        "$type": "duration",
        "$value": { "value": 200, "unit": "ms" },
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Default",
            "modes": { "Reduced motion": { "value": 0, "unit": "ms" } }
          }
        }
      },
      "slow": {
        "$type": "duration",
        "$value": { "value": 300, "unit": "ms" },
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Default",
            "modes": { "Reduced motion": { "value": 0, "unit": "ms" } }
          }
        }
      }
    },
    "hover": {
      "duration": {
        "$type": "duration",
        "$value": { "value": 150, "unit": "ms" },
        "$description": "Same as --motion-duration-fast.",
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Default",
            "modes": { "Reduced motion": { "value": 0, "unit": "ms" } }
          }
        }
      }
    },
    "easing": {
      "default": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 0.2, 1],
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Default",
            "modes": { "Reduced motion": [0.4, 0, 0.2, 1] }
          }
        }
      },
      "emphasis": {
        "$type": "cubicBezier",
        "$value": [0.34, 1.56, 0.64, 1],
        "$extensions": {
          "figma-console-mcp": {
            "primaryMode": "Default",
            "modes": { "Reduced motion": [0.34, 1.56, 0.64, 1] }
          }
        }
      }
    }
  },
  "Radius": {
    "sm": {
      "$type": "dimension",
      "$value": { "value": 6, "unit": "px" },
      "$description": "--radius × 0.6."
    },
    "md": {
      "$type": "dimension",
      "$value": { "value": 8, "unit": "px" },
      "$description": "--radius × 0.8."
    },
    "lg": {
      "$type": "dimension",
      "$value": { "value": 10, "unit": "px" },
      "$description": "Same as --radius."
    },
    "xl": {
      "$type": "dimension",
      "$value": { "value": 14, "unit": "px" },
      "$description": "--radius × 1.4."
    },
    "2xl": {
      "$type": "dimension",
      "$value": { "value": 18, "unit": "px" },
      "$description": "--radius × 1.8."
    },
    "3xl": {
      "$type": "dimension",
      "$value": { "value": 22, "unit": "px" },
      "$description": "--radius × 2.2."
    },
    "4xl": {
      "$type": "dimension",
      "$value": { "value": 26, "unit": "px" },
      "$description": "--radius × 2.6."
    }
  },
  "Spacing": {
    "icon": {
      "$type": "number",
      "$value": 1.25,
      "$description": "1.25em in code: a share of the font size, which a Figma variable can't hold."
    }
  },
  "Breakpoint": {
    "tablet": {
      "$type": "dimension",
      "$value": { "value": 768, "unit": "px" },
      "$description": "48rem in code."
    },
    "desktop": {
      "$type": "dimension",
      "$value": { "value": 1024, "unit": "px" },
      "$description": "64rem in code."
    }
  }
}
